# syntax=docker/dockerfile:1
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml README.md ./
COPY gateway ./gateway
COPY mcp_server ./mcp_server
COPY dashboard/video ./dashboard/video
COPY earner ./earner

RUN pip install --no-cache-dir \
    "fastapi>=0.115" \
    "uvicorn[standard]>=0.32" \
    "sqlalchemy>=2.0" \
    "pydantic>=2.0" \
    "pydantic-settings>=2.0" \
    "httpx>=0.27" \
    "aiofiles>=24.1" \
    "python-multipart>=0.0.9" \
    "opencv-python-headless>=4.10" \
    "pillow>=10.0"

ENV STORAGE_PATH=/data \
    DATABASE_URL=sqlite:////data/video_gateway.db \
    AUTH_MODE=required \
    PYTHONPATH=/app

VOLUME ["/data"]
EXPOSE 8080

# Gateway has NO GPU — never report generation_available without VIDEO_WORKER_URL.
CMD ["python", "-m", "uvicorn", "gateway.main:app", "--host", "0.0.0.0", "--port", "8080"]
