# Grey Quantum firm API (Python)
FROM python:3.12-slim

WORKDIR /app
COPY pyproject.toml README.md ./
COPY earner ./earner
COPY docs ./docs

RUN pip install --no-cache-dir -e .

ENV EARNER_WORKDIR=/data
ENV PORT=8787
ENV FIRM_OWNER_SECRET=owner-dev-secret-change-me

EXPOSE 8787
CMD ["sh", "-c", "mkdir -p \"$EARNER_WORKDIR/firm\" && earner firm serve --host 0.0.0.0 --port ${PORT:-8787} --workdir \"$EARNER_WORKDIR/firm\""]
