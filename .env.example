# ── Claude ───────────────────────────────────────────────────────────────
# Without this the agents cannot think. `ant auth login` also works.
ANTHROPIC_API_KEY=sk-ant-...
EARNER_MODEL=claude-opus-5
EARNER_EFFORT=high

# ── Mode ─────────────────────────────────────────────────────────────────
# sandbox = simulated invoices, nothing sent, no card charged (default)
# live    = real Stripe invoices, real money
EARNER_MODE=sandbox
EARNER_WORKDIR=./.earner

# What the firm sells. Shapes pricing, pitches and social content.
EARNER_OFFER=research, analysis and written deliverables for small businesses

# ── Money rails ──────────────────────────────────────────────────────────
STRIPE_API_KEY=sk_live_...

# ── Guardrails ───────────────────────────────────────────────────────────
EARNER_MAX_LLM_COST_CENTS=200   # hard cap on token spend per job
EARNER_MIN_MARGIN_CENTS=100     # decline work that cannot clear this margin

# ── Gmail ────────────────────────────────────────────────────────────────
# Enable 2-Step Verification, then create an App Password:
# https://myaccount.google.com/apppasswords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Instagram ────────────────────────────────────────────────────────────
# Business/Creator account linked to a Facebook Page, Meta app with
# instagram_content_publish, long-lived access token.
INSTAGRAM_USER_ID=17841400000000000
INSTAGRAM_ACCESS_TOKEN=EAAG...

# ── Upwork ───────────────────────────────────────────────────────────────
# Key from https://www.upwork.com/developer/keys/apply — needs
# "Common Entities - Read-Only Access" plus job-search scope.
# Discovery only: the API has no proposal-submission mutation.
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_REDIRECT_URI=https://localhost/callback
UPWORK_SEARCHES=ai agent,ai automation,workflow automation

# ── Autonomy ─────────────────────────────────────────────────────────────
# Agents source their own work (niche scouting, topic research).
EARNER_AUTONOMOUS=0
# Required before --approve auto may run against live money.
EARNER_ALLOW_LIVE_AUTOAPPROVE=0
