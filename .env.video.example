# Video gateway / worker — copy to .env and fill secrets. Never commit real tokens.
# Generate keys: python scripts/generate_gateway_api_key.py
#                 python scripts/generate_gateway_api_key.py --label WORKER_TOKEN
# Placeholders like change-me-gateway-key / changeme are rejected when AUTH_MODE=required.

API_KEY=
WORKER_TOKEN=
DATABASE_URL=sqlite:///./data/video_gateway.db
STORAGE_PATH=./data
VIDEO_WORKER_URL=
DEFAULT_ENGINE=auto
MODEL_CACHE=./models
HF_HOME=./models/hf
HF_TOKEN=
LOG_LEVEL=INFO
MAX_VRAM_PERCENT=90
AUTH_MODE=required
ALLOW_UNAUTHENTICATED=false
ALLOW_MOCK_INFERENCE=false
COMPUTE_COST_PER_GPU_HOUR_USD=0.50
MIN_SOCIAL_DURATION=30
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
WORKER_HOST=0.0.0.0
WORKER_PORT=8090
WORKER_ID=worker-1
WAN_REPO=./third_party/Wan2.2
LTX_REPO=./third_party/LTX-Video
FRAMEPACK_REPO=./third_party/FramePack
VIDEO_GATEWAY_URL=http://127.0.0.1:8080
